# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy các giá trị này tại https://manage.sanity.io sau khi tạo project.

# Project settings -> Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Thường là "production" (dataset mặc định khi tạo project)
NEXT_PUBLIC_SANITY_DATASET=production

# API -> Tokens -> Add API token -> quyền "Editor"
# Dùng để chạy script nạp dữ liệu mẫu (scripts/seed-sanity.mjs). Giữ bí mật,
# KHÔNG commit giá trị thật lên GitHub.
SANITY_API_TOKEN=

# Chuỗi bí mật tự đặt (ví dụ chuỗi ký tự ngẫu nhiên bất kỳ), dùng ở
# API -> Webhooks khi tạo webhook trỏ về /api/revalidate.
SANITY_REVALIDATE_SECRET=
